# Airflow 2.x, deliberately, not 3.x.
#
# This was 3.0.2. Under 3.0.2 no DAG run could ever be completed on this stack:
# a task would start, log correctly, return its value and push xcom, and the
# scheduler would never record it as succeeded, so nothing downstream ran. That
# survived splitting `standalone` into separate components, wiring
# EXECUTION_API_SERVER_URL, and sharing a JWT secret
# and the design docs.
#
# Airflow 3 routes every running task through an execution API served by the
# api-server, authenticated with JWT. Airflow 2's LocalExecutor forks the task
# in-process and writes the result straight to the metadata DB -- far fewer
# moving parts between "task finished" and "state recorded", and no component
# that can silently fail to acknowledge a completion.
#
# The DAG code was already written to run on both (`airflow.sdk` with an
# `airflow.datasets`/`airflow.decorators` fallback, Asset aliased to Dataset),
# so this is an infrastructure change only.
FROM apache/airflow:2.10.5-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      openjdk-17-jre-headless curl procps \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Nessie GC tool. There is no server-side GC endpoint and no REST call for it --
# collecting content unreachable from ANY Nessie reference is only possible with
# this external CLI, and docs/MAINTENANCE.md has it as step 3 of the nightly
# chain. Published as a GitHub release asset, NOT on Maven Central under this
# name. Pinned to the Nessie server version in docker-compose.yml; keep them
# equal. ~128 MB, which is most of this image's size.
ARG NESSIE_VERSION=0.99.0
RUN mkdir -p /opt/platform/lib \
    && curl -fsSL -o /opt/platform/lib/nessie-gc.jar \
       "https://github.com/projectnessie/nessie/releases/download/nessie-${NESSIE_VERSION}/nessie-gc-${NESSIE_VERSION}.jar" \
    && chown -R airflow: /opt/platform/lib

USER airflow
# Providers go in under Airflow's own constraints so pip cannot quietly drag in
# a different airflow version to satisfy them.
# In the corporate environment these resolve via the internal Registry mirror;
# pip.conf / SSL cert config is injected at build time there.
RUN pip install --no-cache-dir \
      --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.10.5/constraints-3.11.txt" \
      "apache-airflow-providers-apache-spark" \
      "apache-airflow-providers-amazon"

# dbt and pyspark are deliberately NOT constrained by Airflow's file -- their
# pins are the ones validated against a live stack and must not move.
#
# EXCEPT `duckdb`, bumped 1.1.3 -> 1.5.5 for the DuckDB console. 1.1.3's
# iceberg extension has no catalog ATTACH at all -- `ATTACH ... (TYPE ICEBERG)`
# fails with `Binder Error: Unrecognized storage type "ICEBERG"`, which is
# exactly that. 1.5.5 attaches to an Iceberg REST catalog and reads it,
# which is what `scripts/duckdb_console.py` needs.
#
# There is NO dbt-duckdb here, on purpose. D7 briefly installed 1.9.6 to make
# a `duckdb_local` dbt target work, and the target was then removed: DuckDB
# cannot address a Nessie branch, so a build through it bypasses
# write-audit-publish. With no DuckDB target left the adapter was dead weight
# that made `dbt --version` report "duckdb: 1.9.6 - Not compatible!" at anyone
# debugging -- a misleading signal for a package nothing used. The plain
# `duckdb` library below is what the read-only console imports.
RUN pip install --no-cache-dir \
      "dbt-core==1.8.7" \
      "dbt-spark[PyHive]==1.8.0" \
      "duckdb==1.5.5" \
      "pyspark==3.5.3" \
      "pyyaml" "boto3" "pandas" "pyarrow"

# The feed console (reporting_platform/ui) and what it needs to edit config
# without destroying it. ruamel.yaml rather than the pyyaml already installed
# above: feeds.yml is mostly comments explaining why each feed is configured
# the way it is, and a pyyaml load/dump round trip deletes every one of them.
# pyyaml stays for the read-only config loading in common/context.py.
#
# Installed in the same image as everything else because the console imports
# common.context, ingest.arrival and the dbt project layout directly -- a
# separate slimmer image would have to duplicate the platform package and
# could then be built against a different version of it.
RUN pip install --no-cache-dir \
      "fastapi==0.115.6" \
      "uvicorn[standard]==0.34.0" \
      "python-multipart==0.0.20" \
      "ruamel.yaml==0.18.6"

# Astronomer Cosmos: renders the dbt project into Airflow tasks -- one task per
# model, one per test -- instead of the single opaque `dbt run` subprocess the
# build DAGs used to shell out to. A failing model is then a red task with that
# model's name on it, and a rerun starts from the model that failed rather than
# from the top of the layer.
#
# --no-deps, AND THAT IS NOT AN OPTIMISATION. Installing this the way the
# providers above are installed -- under Airflow's constraint file -- BREAKS
# DBT. The 2.10.5 constraints pin `typing_extensions==4.12.2`; the dbt layer
# above resolves `mashumaro` 3.22, whose `pack.py` imports
# `evaluate_forward_ref` from typing_extensions 4.13+. Cosmos depends on
# typing-extensions, so the constrained install DOWNGRADES 4.16.0 -> 4.12.2 and
# every subsequent `dbt` invocation dies at import with
#   ImportError: cannot import name 'evaluate_forward_ref' from 'typing_extensions'
# -- in dbt, not in cosmos, and not until something runs dbt. Verified by
# building this image both ways and running `dbt --version`.
#
# So: install cosmos alone and add its two genuinely-new dependencies by hand.
# `pip install --dry-run` against this image showed the whole delta was
# `aenum` + `deprecation` (plus that typing_extensions downgrade); everything
# else cosmos wants -- airflow, attrs, packaging, msgpack, pydantic, virtualenv
# -- is already present at a version it accepts. Re-run that dry run before
# moving COSMOS_VERSION.
#
# Cosmos invokes the `dbt` EXECUTABLE installed above (see
# ExecutionConfig.dbt_executable_path in airflow/dags/dbt_builds.py) rather
# than importing dbt-core, so the validated dbt-core==1.8.7 /
# dbt-spark==1.8.0 pins stay authoritative.
ARG COSMOS_VERSION=1.15.1
RUN pip install --no-cache-dir --no-deps "astronomer-cosmos==${COSMOS_VERSION}"     && pip install --no-cache-dir "aenum" "deprecation"     && dbt --version >/dev/null     && python -c "import cosmos; print('cosmos', cosmos.__version__)"

# Marimo, for the developer exploration notebook (notebooks/explore.py, served
# by the `notebook` service on 8083). Marimo rather than Jupyter because its
# notebooks ARE Python files -- they diff, review and merge like any other
# source in this repo, where a Jupyter .ipynb is a JSON blob carrying outputs
# and execution counts that make every save a conflict.
#
# Installed unpinned deps but marimo itself pinned: `pip install --dry-run`
# against this image showed it adds only new packages (jedi, msgspec,
# narwhals, pyzmq and friends) and moves nothing already here -- notably NOT
# typing_extensions, which is the one that broke dbt when cosmos went in under
# a constraint file. Re-run that dry run before moving this pin.
ARG MARIMO_VERSION=0.24.0
RUN pip install --no-cache-dir "marimo==${MARIMO_VERSION}" \
    && dbt --version >/dev/null \
    && python -c "import marimo, duckdb; print('marimo', marimo.__version__)"
