# Airflow 2.x, deliberately, not 3.x. See docs/DECISIONS.md#airflow-2-not-3
#
# TWO TARGETS. `dev` (everything up to the permissions layer) is what compose
# builds, with the code BIND-MOUNTED so an edit is live. `release` is `dev`
# plus the code and the dbt packages, for a cluster with no mounts at all.
# Compose pins `target: dev`; without it, a multi-stage build defaults to the
# LAST stage. See docs/DECISIONS.md#the-release-image-carries-the-code
FROM apache/airflow:2.10.5-python3.11 AS dev

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      openjdk-17-jre-headless curl procps \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Nessie GC tool. The only way to collect content unreachable from any Nessie
# reference; version tracks the server. ~128 MB, most of this image's size.
# See docs/DECISIONS.md#nessie-gc-jar
ARG NESSIE_SERVER_VERSION=0.108.1
RUN mkdir -p /opt/platform/lib \
    && curl -fsSL -o /opt/platform/lib/nessie-gc.jar \
       "https://github.com/projectnessie/nessie/releases/download/nessie-${NESSIE_SERVER_VERSION}/nessie-gc-${NESSIE_SERVER_VERSION}.jar" \
    && chown -R airflow: /opt/platform/lib

USER airflow
# Providers under Airflow's own constraints, so pip cannot drag in a different
# airflow version to satisfy them. In the corporate environment these resolve
# via the internal registry mirror; pip.conf / SSL cert config is injected at
# build time there. See docs/DECISIONS.md#airflow-provider-constraints
RUN pip install --no-cache-dir \
      --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.10.5/constraints-3.11.txt" \
      "apache-airflow-providers-apache-spark" \
      "apache-airflow-providers-amazon"

# dbt and pyspark are deliberately NOT constrained by Airflow's file; duckdb is
# 1.5.5 because 1.1.3 cannot ATTACH an Iceberg catalog at all. There is no
# dbt-duckdb on purpose. See docs/DECISIONS.md#airflow-provider-constraints
RUN pip install --no-cache-dir \
      "dbt-core==1.8.7" \
      "dbt-spark[PyHive]==1.8.0" \
      "duckdb==1.5.5" \
      "pyspark==3.5.3" \
      "pyyaml" "boto3" "pandas" "pyarrow"

# sqlglot parses the COMPILED dbt SQL into column-level lineage for the
# OpenLineage export. It is here rather than in the constrained block above
# because it is not an Airflow provider, and it is a dependency at all because
# the parser already in the image cannot do the job: openlineage-sql resolves a
# column's origin to the CTE it came through, and the prepared models open with
# `select *`, which nothing can expand without a schema. sqlglot takes one --
# the platform reads it from the catalog already (lineage/schemas.py) -- and
# traces 116 of 136 columns where openlineage-sql managed 26, none of them in
# prepared. Pinned, and verified against Airflow's constraint file first:
# `Would install sqlglot-30.18.0` and nothing else, so this is not the
# typing_extensions trap that --no-deps exists for below.
# See docs/DECISIONS.md#lineage-is-derived-from-the-dbt-project
RUN pip install --no-cache-dir "sqlglot==30.18.0"

# The feed console. ruamel.yaml rather than the pyyaml above because feeds.yml
# is mostly comments and a pyyaml round trip deletes every one of them; pyyaml
# stays for the read-only config loading in common/context.py.
# See docs/DECISIONS.md#feed-ui-same-image
RUN pip install --no-cache-dir \
      "fastapi==0.115.6" \
      "uvicorn[standard]==0.34.0" \
      "python-multipart==0.0.20" \
      "ruamel.yaml==0.18.6"

# Astronomer Cosmos: renders the dbt project into one Airflow task per model.
#
# --no-deps, AND THAT IS NOT AN OPTIMISATION -- installing it under Airflow's
# constraint file breaks every subsequent dbt invocation. Re-run
# `pip install --dry-run` before moving COSMOS_VERSION. The `dbt --version`
# smoke check below is what stops that shipping silently.
# See docs/DECISIONS.md#cosmos-no-deps
ARG COSMOS_VERSION=1.15.1
RUN pip install --no-cache-dir --no-deps "astronomer-cosmos==${COSMOS_VERSION}" \
    && pip install --no-cache-dir "aenum" "deprecation" \
    && dbt --version >/dev/null \
    && python -c "import cosmos; print('cosmos', cosmos.__version__)"

# Marimo, for notebooks/explore.py. Pinned; its deps are not, because they move
# nothing already installed. Re-run that dry run before moving the pin.
# See docs/DECISIONS.md#marimo-not-jupyter
ARG MARIMO_VERSION=0.24.0
RUN pip install --no-cache-dir "marimo==${MARIMO_VERSION}" \
    && dbt --version >/dev/null \
    && python -c "import marimo, duckdb; print('marimo', marimo.__version__)"

# THE DRIVER'S JARS, baked in rather than resolved by Ivy at session start.
# Every submitting process here -- spark_session() and dbt's spark_local
# target -- is a pip pyspark with NO Iceberg, Nessie or S3A jars of its own.
# It used to fetch them from Maven Central through spark.jars.packages on
# every cold start, which is a runtime dependency on egress that a cluster
# does not have. Both drivers now read PLATFORM_DRIVER_JARS below, set as
# spark.jars, which also SHIPS them to the executors -- how hadoop-aws, which
# Dockerfile.spark does not bake, reaches them at all.
#
# The versions must equal Dockerfile.spark's, and tests/test_versions.py
# checks that they do. hadoop-aws tracks the Hadoop that pyspark 3.5.3
# bundles, and aws-java-sdk-bundle tracks hadoop-aws.
# See docs/DECISIONS.md#jar-versions, docs/DECISIONS.md#driver-jars-are-baked
ARG MAVEN_REPO=https://repo1.maven.org/maven2
ARG ICEBERG_VERSION=1.6.1
ARG NESSIE_SPARK_EXT_VERSION=0.99.0
ARG HADOOP_AWS_VERSION=3.3.4
ARG AWS_SDK_BUNDLE_VERSION=1.12.262
USER root
RUN set -eux; \
    J=/opt/platform/jars; mkdir -p $J; \
    curl -fsSL -o $J/iceberg-spark-runtime.jar \
      "${MAVEN_REPO}/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/${ICEBERG_VERSION}/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar"; \
    curl -fsSL -o $J/iceberg-aws-bundle.jar \
      "${MAVEN_REPO}/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar"; \
    curl -fsSL -o $J/nessie-spark-extensions.jar \
      "${MAVEN_REPO}/org/projectnessie/nessie-integrations/nessie-spark-extensions-3.5_2.12/${NESSIE_SPARK_EXT_VERSION}/nessie-spark-extensions-3.5_2.12-${NESSIE_SPARK_EXT_VERSION}.jar"; \
    curl -fsSL -o $J/hadoop-aws.jar \
      "${MAVEN_REPO}/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar"; \
    curl -fsSL -o $J/aws-java-sdk-bundle.jar \
      "${MAVEN_REPO}/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_BUNDLE_VERSION}/aws-java-sdk-bundle-${AWS_SDK_BUNDLE_VERSION}.jar"; \
    chown -R airflow:0 $J; chmod -R g+rX $J
ENV PLATFORM_DRIVER_JARS=/opt/platform/jars/iceberg-spark-runtime.jar,/opt/platform/jars/iceberg-aws-bundle.jar,/opt/platform/jars/nessie-spark-extensions.jar,/opt/platform/jars/hadoop-aws.jar,/opt/platform/jars/aws-java-sdk-bundle.jar
USER airflow

# ---------------------------------------------------------------------------
USER root
# dbt's working directories, outside the ./dbt bind mount because a bind mount
# takes its ownership from the host. airflow:0 with g+rwX, so an arbitrary
# assigned uid in group 0 can still write.
# See docs/DECISIONS.md#dbt-working-directories
#
# Last in the file so it cannot invalidate the pip layers above.
# See docs/DECISIONS.md#image-permissions-layer
RUN mkdir -p /opt/platform/run/dbt/logs /opt/platform/run/dbt/target \
             /opt/platform/run/packages \
    && chown -R airflow:0 /opt/platform/run \
    && chmod -R g+rwX /opt/platform/run
USER airflow

# ---------------------------------------------------------------------------
# RELEASE: the same image with the code in it, at the paths compose mounts it.
# Nothing a DAG, a task or the console reads may come from a mount here --
# `docker run <image> python -m scripts.check_dag_imports` with no mounts is
# the proof. Tests, seeds and docs stay out: this is a runtime image.
FROM dev AS release

COPY --chown=airflow:0 airflow/dags          /opt/airflow/dags
COPY --chown=airflow:0 reporting_platform    /opt/platform/reporting_platform
COPY --chown=airflow:0 reporting_transport   /opt/platform/reporting_transport
COPY --chown=airflow:0 scripts               /opt/platform/scripts
COPY --chown=airflow:0 dbt                   /opt/platform/dbt

# Paths that are facts about THIS image, not about an environment, so they
# live here rather than in a chart ConfigMap. The same values compose sets on
# its airflow anchor. See docs/DECISIONS.md#dbt-working-directories
ENV PYTHONPATH=/opt/platform \
    DBT_PROJECT_DIR=/opt/platform/dbt \
    DBT_PROFILES_DIR=/opt/platform/dbt \
    DBT_LOG_PATH=/opt/platform/run/dbt/logs \
    DBT_TARGET_PATH=/opt/platform/run/dbt/target

# dbt packages AT BUILD TIME, into the path dbt_project.yml's
# packages-install-path defaults to, so airflow-init needs no network for
# them on a cluster. Without packages `dbt ls` cannot compile a dbt_utils
# test and both build DAGs fail to IMPORT.
# See docs/DECISIONS.md#airflow-init-load-bearing-steps
RUN dbt deps --project-dir /opt/platform/dbt --profiles-dir /opt/platform/dbt \
    && chmod -R g+rwX /opt/platform/run /opt/platform/dbt
