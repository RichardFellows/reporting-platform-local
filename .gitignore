.env
seed/
seed_clean/
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Where .github/workflows/parse.yml puts dbt's and Airflow's working
# directories: inside the workspace, because a job-level `env:` cannot see
# the `runner` context. Ephemeral on a runner; ignored here so running the
# same commands locally does not dirty the tree.
.ci/
__pycache__/
*.pyc

# artifacts from clearing stale git locks on this machine's mount
_to_delete/

# Scratch from the Nessie REST API debugging: the live
# server's OpenAPI spec, pulled to check request shapes, plus a probe log.
# Kept out of the tree rather than committed -- regenerate with
# `curl -s http://localhost:19120/nessie-openapi/openapi.yaml` if needed.
nessie-openapi.json
nessie-openapi.yaml
nessie-test.txt

# Files dropped for ingestion, and the watcher's bookkeeping. The directory is
# tracked (inbox/.gitkeep) so a clone has somewhere to drop them; what lands in
# it is data, not source.
inbox/*
!inbox/.gitkeep

# marimo's per-session state, written beside the notebook it belongs to.
# The notebook itself IS the source and is committed -- that is the whole
# reason for marimo over Jupyter -- but this directory is scratch: cell
# outputs and execution state, rewritten on every run.
__marimo__/

# Claude Code agent sessions run with worktree isolation check the repo out
# under .claude/worktrees/<id>/, INSIDE this checkout. Unignored, every
# `git status` is dirty while one runs and `git add -A` stages a nested
# checkout. This does NOT stop a plain repo-root `grep -r` finding their copies
# -- grep does not read .gitignore; pass `--exclude-dir=.claude`, or use
# `git grep`. Only the worktrees: project settings, agents and skills under
# .claude/ are meant to be committable.
.claude/worktrees/

# editor
.vscode/
var/

# Windows/msys crash dumps
*.stackdump
release.env
