# MinIO server and client on UBI, built FROM SOURCE.
# See docs/DECISIONS.md#minio-is-built-from-source
#
# No registry still serves MinIO's own images anonymously: Docker Hub's
# `minio/*` began refusing pulls first (docs/DECISIONS.md#minio-images-come-
# from-quay), then quay.io's copies started answering 401 on 2026-09-24, and
# ghcr.io denies them too. The source is still published per release tag, so
# the same pinned releases are compiled here instead, the way Marquez is
# (docs/DECISIONS.md#marquez-on-ubi). One image carries both binaries: the
# `minio` service runs the server and its healthcheck calls `mc`, and
# `minio-init` runs `mc` to make the bucket.
ARG MINIO_RELEASE=RELEASE.2024-09-22T00-33-43Z
ARG MC_RELEASE=RELEASE.2024-09-16T17-43-14Z

# --------------------------------------------------------------------- build
# Both releases' go.mod say `go 1.22`.
FROM registry.access.redhat.com/ubi9/go-toolset:1.22.9 AS build
ARG MINIO_RELEASE
ARG MC_RELEASE
USER root
WORKDIR /src

# EVERY FETCH IS A BUILD ARG so the corporate mirror can redirect it: the two
# release tarballs, and GOPROXY for the modules both resolve. The tarball
# rather than a clone, as Dockerfile.marquez-api does -- so there is no git,
# and the commit id MinIO's own Makefile reads from `git` is not available.
# See docs/DECISIONS.md#images-build-from-a-mirror
ARG MINIO_SOURCE_URL=https://github.com/minio/minio/archive/refs/tags/${MINIO_RELEASE}.tar.gz
ARG MC_SOURCE_URL=https://github.com/minio/mc/archive/refs/tags/${MC_RELEASE}.tar.gz
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY} CGO_ENABLED=0 GOFLAGS=-mod=mod

RUN mkdir minio mc \
    && curl -fsSL "${MINIO_SOURCE_URL}" | tar xz --strip-components=1 -C minio \
    && curl -fsSL "${MC_SOURCE_URL}" | tar xz --strip-components=1 -C mc

# WHAT EACH PROJECT'S `make install` DOES, minus git: `-tags kqueue
# -trimpath`, and the ldflags its buildscripts/gen-ldflags.go writes. Version
# is the tag's timestamp with `:` restored, as releaseTag() parses it back, so
# `minio --version` names the release rather than DEVELOPMENT. CommitID is
# the tag itself -- the tarball has no commit to read.
RUN set -eu; \
    stamp() { t=${1#RELEASE.}; d=${t%%T*}; h=$(echo "${t#*T}" | tr - :); \
              echo "${d}T${h}"; }; \
    v=$(stamp "${MINIO_RELEASE}"); \
    cd /src/minio && go build -tags kqueue -trimpath -o /out/minio -ldflags "-s -w \
      -X github.com/minio/minio/cmd.Version=${v} \
      -X github.com/minio/minio/cmd.CopyrightYear=${v%%-*} \
      -X github.com/minio/minio/cmd.ReleaseTag=${MINIO_RELEASE} \
      -X github.com/minio/minio/cmd.CommitID=${MINIO_RELEASE} \
      -X github.com/minio/minio/cmd.ShortCommitID=${MINIO_RELEASE}" .; \
    v=$(stamp "${MC_RELEASE}"); \
    cd /src/mc && go build -tags kqueue -trimpath -o /out/mc -ldflags "-s -w \
      -X github.com/minio/mc/cmd.Version=${v} \
      -X github.com/minio/mc/cmd.CopyrightYear=${v%%-*} \
      -X github.com/minio/mc/cmd.ReleaseTag=${MC_RELEASE} \
      -X github.com/minio/mc/cmd.CommitID=${MC_RELEASE} \
      -X github.com/minio/mc/cmd.ShortCommitID=${MC_RELEASE}" .

# ------------------------------------------------------------------- runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.4
COPY --from=build /out/minio /out/mc /usr/bin/
# Root, as the upstream image ran: an existing `minio-data` volume was written
# by it, and a server that cannot read its own data starts EMPTY rather than
# failing -- the bucket, every raw table and every published tag, gone from
# view. Changing the user needs that volume's ownership changed with it.
EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/minio"]
