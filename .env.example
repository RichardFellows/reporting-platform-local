# Copy to .env and adjust. Nothing here is a real credential.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
REPORTING_ENV=local

# spark_local   (spark_ocp in the cluster)
#
# Both dbt targets are Spark, and dbt_builds.py refuses anything that is not.
# A build has to land on a Nessie branch -- that is write-audit-publish -- and
# only the Spark path can address one. DuckDB was tried as a second engine in
# session 5 and removed: it can only ever reach the catalog's default branch,
# it silently drops `partition_by`, and it cannot INSERT to a partitioned
# table.1".
#
# DuckDB is still available to people, read-only, against published `main`:
#   docker compose exec -T airflow python -m scripts.duckdb_console --tables
DBT_TARGET=spark_local

# MinIO's HOST ports. The container always listens on 9000/9001; these are
# only what your machine exposes them as. Defaulted off 9000/9001 because
# ZScaler and various local dev servers take those -- change them here if
# something on your machine wants 19000/19001 instead.
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
