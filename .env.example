# Copy to .env and adjust. Nothing here is a real credential.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
REPORTING_ENV=local

# spark_local   (spark_ocp in the cluster)
#
# Both dbt targets are Spark, and dbt_builds.py refuses anything that is not.
# A build has to land on a Nessie branch -- that is write-audit-publish -- and
# only the Spark path can address one. DuckDB was tried as a second engine in
# session 5 and removed: it can only ever reach the catalog's default branch,
# it silently drops `partition_by`, and it cannot INSERT to a partitioned
# table.1".
#
# DuckDB is still available to people, read-only, against published `main`:
#   docker compose exec -T airflow python -m scripts.duckdb_console --tables
DBT_TARGET=spark_local

# ------------------------------------------------------------ jar versions
#
# THREE values, not one, and the split is the finding rather than pedantry.
#
# ICEBERG_VERSION is the Iceberg runtime. It has to be the same number in three
# places -- baked into the Spark image's /opt/spark/jars, and resolved via Ivy
# by each of the two DRIVERS (common/context.py and dbt/profiles.yml), because
# every process that submits work here runs a pip-installed pyspark with no
# jars of its own. `spark.jars.packages` ships the driver's jars to every
# executor, so a mismatch does not fail cleanly: you get two Iceberg versions
# in one application and a NoSuchMethodError on the first write. Setting it
# here sets all three.
#
# NESSIE_SPARK_EXT_VERSION tracks ICEBERG_VERSION, NOT the server. The
# extensions jar is compiled against a specific Iceberg -- 0.99.0 against
# Iceberg 1.5.x, 0.103.3 against 1.8.1, 0.108.1 against 1.11.0 -- and running
# one compiled against a NEWER Iceberg than you actually have is the direction
# that throws NoSuchMethodError. Pick the newest extensions release built
# against an Iceberg no newer than yours.
#
# NESSIE_SERVER_VERSION sets the server image tag AND the nessie-gc jar in
# Dockerfile.airflow, which must be equal to it: there is no server-side GC
# endpoint, so that CLI alone decides what is unreachable and deletes it. The
# server is ALLOWED to be newer than the extensions -- REST API v2 is stable
# across that range -- which is what makes a security-mandated server bump
# possible without moving the Spark jars.
#
# Defaults are the combination this stack has actually been run against.
# Known-good alternative, for a base image baking Iceberg 1.9.1 (which is the
# pairing Apache Iceberg 1.9.1 itself declares) with a server pinned newer for
# CVE reasons:
#   ICEBERG_VERSION=1.9.1
#   NESSIE_SPARK_EXT_VERSION=0.103.3
#   NESSIE_SERVER_VERSION=0.108.1
# Going up from a 0.99.0 server crosses two notes worth reading first: 0.100.0
# stopped returning *FileIO options from the Iceberg REST config endpoint
# (which is what scripts/duckdb_console.py talks to), and the JDBC version
# store migrates one-way on first start.
ICEBERG_VERSION=1.6.1
NESSIE_SPARK_EXT_VERSION=0.99.0
NESSIE_SERVER_VERSION=0.99.0

# ---------------------------------------------------------------- host ports
#
# EVERY VALUE HERE IS THE HOST SIDE ONLY. Containers always listen on their
# own fixed ports, and they address each other by service name -- minio:9000,
# postgres:5432, spark-master:7077 and so on -- so changing anything below
# cannot affect the pipeline. It only changes what your machine exposes.
#
# Defaults are the conventional ports except MinIO's, which are moved off
# 9000/9001 because ZScaler on a corporate laptop takes those. The rest are
# left where they are so nothing moves unless you move it -- but they are the
# usual suspects for a clash, 8080 and 5432 especially, so they are here ready.
#
# Note *_HOST_PORT, deliberately: FEED_UI_PORT already exists and sets the
# port the console binds INSIDE its container. Setting that one would move the
# listener out from under the mapping.
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
POSTGRES_HOST_PORT=5432
NESSIE_HOST_PORT=19120
SPARK_MASTER_HOST_PORT=7077
SPARK_UI_HOST_PORT=8080
AIRFLOW_HOST_PORT=8081
FEED_UI_HOST_PORT=8082
NOTEBOOK_HOST_PORT=8083
