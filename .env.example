# Copy to .env and adjust. Nothing here is a real credential.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
REPORTING_ENV=local

# ----------------------------------------------------------------- your uid
#
# SET THIS TO YOUR OWN `id -u` ON LINUX. The Airflow containers run as
# `${AIRFLOW_UID:-50000}:0`, and several bind mounts here are written by the
# container, not just read: the feed console writes feeds.yml, the dbt source
# file and a scaffolded model; the inbox watcher creates `inbox/.processed/`
# and moves delivered files into it. A bind mount keeps the HOST's ownership,
# which no `chown` in the image can reach, so a container running as 50000
# cannot write a checkout owned by you.
#
# The failure does not mention permissions. The console returns a 500 with the
# traceback only in `docker compose logs feed-ui`, and the inbox watcher
# uploads a delivery to landing correctly and THEN dies moving the local file.
#
# Group 0 is not configurable and must not be changed: everything the image
# writes is `airflow:0` with `g+rwX` (Dockerfile.airflow's last layer), which
# is what lets an arbitrary uid run it at all.
#
#   Linux:            AIRFLOW_UID=$(id -u)     -- usually 1000
#   macOS / Windows:  leave unset. Docker Desktop's VM maps ownership for you
#                     and the default 50000 is correct.
AIRFLOW_UID=1000

# Which Spark target dbt builds through -- spark_local here, spark_ocp in the
# cluster. Both are Spark; dbt_builds.py refuses anything that is not.
# See docs/DECISIONS.md#duckdb-is-not-an-engine
DBT_TARGET=spark_local

# ------------------------------------------------------------- jar versions
#
# Three values, not one, and the split matters: ICEBERG_VERSION must be
# identical in the Spark image and both drivers; NESSIE_SPARK_EXT_VERSION tracks
# Iceberg rather than the server; NESSIE_SERVER_VERSION sets the server image
# and the nessie-gc jar and may be newer than the extensions.
# See docs/DECISIONS.md#jar-versions
#
# Defaults are the combination this stack was validated against. A known-good
# alternative, for a base image baking Iceberg 1.9.1 with a server pinned newer
# for CVE reasons:
#   ICEBERG_VERSION=1.9.1
#   NESSIE_SPARK_EXT_VERSION=0.103.3
#   NESSIE_SERVER_VERSION=0.108.1
ICEBERG_VERSION=1.6.1
NESSIE_SPARK_EXT_VERSION=0.99.0
NESSIE_SERVER_VERSION=0.99.0

# -------------------------------------------------------------- host ports
#
# Host side only -- containers keep their own fixed ports and address each other
# by service name, so nothing below can affect the pipeline. MinIO defaults away
# from 9000/9001 because those collide with ZScaler and local dev servers.
# See docs/DECISIONS.md#minio-host-ports
#
# Note *_HOST_PORT: FEED_UI_PORT already exists and sets the port the console
# binds INSIDE its container.
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
POSTGRES_HOST_PORT=5432
NESSIE_HOST_PORT=19120
SPARK_MASTER_HOST_PORT=7077
SPARK_UI_HOST_PORT=8080
AIRFLOW_HOST_PORT=8081
FEED_UI_HOST_PORT=8082
NOTEBOOK_HOST_PORT=8083
MARQUEZ_API_HOST_PORT=15000
MARQUEZ_ADMIN_HOST_PORT=15001
MARQUEZ_WEB_HOST_PORT=13000

# ------------------------------------------------- OpenLineage -> Marquez
#
# Airflow emits an OpenLineage event per task run; Marquez consumes them and
# draws the graph. Both halves are OFF by default and turn on together:
#
#   OPENLINEAGE_DISABLED=false  in .env
#   docker compose --profile lineage up -d marquez-api marquez-web
#   docker compose up -d --force-recreate airflow airflow-webserver airflow-triggerer
#
# The recreate is not optional -- AIRFLOW__OPENLINEAGE__* is read from the
# environment at process start, and editing .env does nothing until the
# container is recreated (see CLAUDE.md).
#
# WHY OFF BY DEFAULT. Marquez is behind the `lineage` profile, so ordinarily
# nothing is listening on marquez-api:5000. The provider does not fail a task
# when the transport refuses a connection -- it logs and moves on -- but a
# nightly chain emitting several hundred failed POSTs is the kind of standing
# noise that teaches people to stop reading task logs.
#
# WHAT IT IS FOR, AND WHAT IT IS NOT. This is an EXPORT, in a standard format,
# for whatever else in the organisation consumes OpenLineage. It is not the
# platform's record of what a run published: `registry.run_input` is, it is
# derived from the rows actually PRESENT in the published tables, and the two
# deliberately answer different questions -- an SCD2 dimension contributes 10
# of its 40 ingested deliveries to a published table, and OpenLineage would
# report all 40 as read. Do not reconcile them; they are not the same number.
#
# THE DATASETS ARE DERIVED, and by the walker retention already trusts. Airflow
# supplies the jobs and nothing else -- an `iceberg://` outlet has no converter,
# and Cosmos's dbt extractor cannot read a `method: session` profile -- so
# `reporting_platform/lineage` supplies what each task reads and writes, out of
# the dbt project and feeds.yml. It is registered in docker-compose.yml rather
# than here (AIRFLOW__OPENLINEAGE__EXTRACTORS) because it is not a setting
# anyone should be turning off: without it the graph has no edges.
# See docs/DECISIONS.md#openlineage-is-an-export-not-a-record
# and docs/DECISIONS.md#lineage-is-derived-from-the-dbt-project
OPENLINEAGE_DISABLED=true
OPENLINEAGE_NAMESPACE=reporting-platform-local
MARQUEZ_VERSION=0.51.1
