FROM apache/spark:3.5.3-python3

USER root

# Jar versions come from .env via compose build args, re-exported as ENV so
# `docker compose exec spark-worker env | grep VERSION` reports what is actually
# baked in. Defaults are the validated combination.
# See docs/DECISIONS.md#jar-versions
ARG ICEBERG_VERSION=1.6.1
ARG NESSIE_SPARK_EXT_VERSION=0.99.0
ENV ICEBERG_VERSION=${ICEBERG_VERSION}
ENV NESSIE_SPARK_EXT_VERSION=${NESSIE_SPARK_EXT_VERSION}
ENV SCALA_VERSION=2.12

# Pre-baked rather than resolved with --packages at submit time: no egress at
# runtime. See docs/DECISIONS.md#spark-jars-prebaked
#
# MAVEN_REPO IS A BUILD ARG, NOT AN INLINE CONSTANT, because the corporate
# build has egress only to an internal mirror: the mirror sets this one arg
# and every URL below follows. Same arg name as the driver-jar layer in
# Dockerfile.airflow, so a build only ever sets one Maven base for the whole
# estate. See docs/DECISIONS.md#images-build-from-a-mirror
ARG MAVEN_REPO=https://repo1.maven.org/maven2
RUN set -eux; \
    JARS=/opt/spark/jars; \
    curl -fsSL -o $JARS/iceberg-spark-runtime.jar \
      ${MAVEN_REPO}/org/apache/iceberg/iceberg-spark-runtime-3.5_${SCALA_VERSION}/${ICEBERG_VERSION}/iceberg-spark-runtime-3.5_${SCALA_VERSION}-${ICEBERG_VERSION}.jar; \
    curl -fsSL -o $JARS/iceberg-aws-bundle.jar \
      ${MAVEN_REPO}/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar; \
    curl -fsSL -o $JARS/nessie-spark-extensions.jar \
      ${MAVEN_REPO}/org/projectnessie/nessie-integrations/nessie-spark-extensions-3.5_${SCALA_VERSION}/${NESSIE_SPARK_EXT_VERSION}/nessie-spark-extensions-3.5_${SCALA_VERSION}-${NESSIE_SPARK_EXT_VERSION}.jar

# NO FALLBACK. `|| pip install pyyaml boto3` used to swallow a pynessie
# install failure and ship an image that imports cleanly and lacks the
# package the platform actually needs at runtime -- a build that "succeeds"
# with a different image than the one asked for. If pynessie stops
# installing, this must fail loudly here, not three layers of indirection
# later at import time.
RUN pip install --no-cache-dir pyyaml boto3 pynessie==0.65.0

ENV PYTHONPATH=/opt/platform

# Last in the file so it cannot invalidate the jar downloads or pip installs
# above it. Group 0 with g+rwX so an arbitrary assigned uid in group 0
# (OpenShift's restricted SCC, which picks a uid this compose file never
# uses) can still write Spark's own work/log/ivy directories.
# See docs/DECISIONS.md#image-permissions-layer
#
# OWNED BY `spark`, NOT root: the image's own user (uid 185, not in group 0)
# is what compose runs, and a root-owned /opt/spark/work made every executor
# launch fail with "Failed to create directory /opt/spark/work/app-..." --
# the worker used to create these itself. `spark:0` serves both users, the
# same arrangement as Dockerfile.airflow's `airflow:0`.
RUN mkdir -p /opt/spark/work /opt/spark/logs /opt/spark/.ivy2 \
    && chown -R spark:0 /opt/spark/work /opt/spark/logs /opt/spark/.ivy2 \
    && chmod -R g+rwX /opt/spark/work /opt/spark/logs /opt/spark/.ivy2

USER spark
